{
  "name": "asset-management",
  "version": "1.0.0",
  "description": "Asset Management - SAP CAP on SAP HANA Cloud with SAPUI5 / SAP Fiori dashboards for admins, managers and employees",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds deploy --to hana && cds watch --profile hybrid",
    "watch-employee": "cds deploy --to hana && cds watch --profile hybrid --open employee/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-department": "cds deploy --to hana && cds watch --profile hybrid --open department/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-manager": "cds deploy --to hana && cds watch --profile hybrid --open manager/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-assets": "cds deploy --to hana && cds watch --profile hybrid --open assets/index.html?sap-ui-xx-viewCache=false --livereload false",
    "build": "cds build --production",
    "build:mta": "mbt build -t mta_archives --mtar asset-management.mtar",
    "deploy": "cf deploy mta_archives/asset-management.mtar --retries 1",
    "undeploy": "cf undeploy asset-management --delete-services --delete-service-keys --delete-service-brokers",
    "watch-dashboard": "cds deploy --to hana && cds watch --profile hybrid --open dashboard/index.html?sap-ui-xx-viewCache=false --livereload false",
    "deploy:db": "cds deploy --to hana"
  },
  "dependencies": {
    "@cap-js/hana": "^3.1.2",
    "@sap/cds": "^10.2.1",
    "@sap/cds-common-content": "^3.2.0",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.2.0",
    "cds-plugin-ui5": "^0.17.0"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/employee",
    "app/department",
    "app/manager",
    "app/assets"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
